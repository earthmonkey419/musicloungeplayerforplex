# MusicLounge Player -- environment variables for Docker/Portainer.
#
# Copy this file to .env and fill in real values. .env is gitignored
# -- never commit it. docker-compose.yml reads from it via env_file:,
# so secrets never need to live in the (version-controlled) compose
# file itself.
#
# Everything here maps 1:1 to config.example.py -- see that file for
# full explanations of each setting. DB_PATH and HOST/PORT are handled
# directly in docker-compose.yml, not here, since they're about the
# container's internal wiring rather than per-deployment secrets.

# --- Required ---
PLEX_URL=http://10.0.0.251:32400
PLEX_TOKEN=REPLACE_ME
MUSIC_LIB=Music
ADMIN_PASSWORD=REPLACE_ME
SECRET_KEY=REPLACE_ME_RANDOM
COOKIE_SECURE=true

# --- Optional: password-reset email ---
ADMIN_RECOVERY_EMAIL=

# --- Optional: SMTP (Share Mode "Email It") ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=
SMTP_FROM_DISPLAY_NAME=MusicLounge Player

# --- Optional: Room Mode tuning (sensible defaults if left blank) ---
ROOM_SESSION_TIMEOUT_MINUTES=90
ROOM_VOLUME_CEILING=80
ROOM_SKIP_RATE_LIMIT_SECONDS=20
ROOM_MAX_QUEUE_ADDS_PER_SESSION=50

# --- Optional: Share Mode tuning ---
SHARE_LINK_DURATIONS_HOURS=24,48,72
SHARE_TOKEN_BYTES=32

# --- Optional: MusicMind read-only bridge ---
# Leave blank to disable -- Player falls back to plain genre-tag mood
# buckets with no degraded functionality. Only meaningful if you also
# mount MusicMind's plex_music_brain.db into the container (see the
# commented-out volume line in docker-compose.yml) and point this at
# that mounted path.
MUSICMIND_DB_PATH=

# --- Optional: Last.fm scrobbling ---
# Leave both blank to disable. Get a key/secret at
# https://www.last.fm/api/account/create -- the admin still has to
# connect their account once via Settings after the container is
# running; these two values alone don't authorize anything.
LASTFM_API_KEY=
LASTFM_API_SECRET=
